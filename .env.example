# ATENÇÃO: variáveis com o prefixo NEXT_PUBLIC_ são embutidas no JavaScript
# enviado ao navegador — qualquer visitante consegue lê-las. Use esse prefixo
# apenas para valores que podem ser públicos. Segredos (chaves de API, senhas)
# ficam SEM o prefixo e só são lidos no servidor.

# Google Tag Manager (Opcional - para rastreamento de Analytics)
NEXT_PUBLIC_GTM =

# URL do seu aplicativo deployado (ex: https://seu-portfolio.vercel.app)
NEXT_PUBLIC_APP_URL =

# Configuração do Telegram Bot (Opcional - para notificações por Telegram)
TELEGRAM_BOT_TOKEN =
TELEGRAM_CHAT_ID =

# Configuração do Gmail (Opcional - para notificações por email)
# Para gerar a senha de app do Gmail:
# 1. Acesse https://myaccount.google.com/
# 2. Vá para Segurança → Verificação em 2 etapas (ative se não estiver)
# 3. Vá para Segurança → Senhas de app
# 4. Selecione: App: Mail, Dispositivo: Outro (Nome customizado)
# 5. Copie a senha de 16 caracteres gerada
GMAIL_PASSKEY =
EMAIL_ADDRESS =

# Chave da API do Assistente de IA (Gemini) - SEGREDO, fica só no servidor
# Para obter sua chave gratuita:
# 1. Acesse https://aistudio.google.com/apikey
# 2. Clique em "Create API Key"
# 3. Cole a chave abaixo
GEMINI_API_KEY =

# reCAPTCHA (Opcional) - a secret key é SEGREDO e nunca leva NEXT_PUBLIC_
RECAPTCHA_SECRET_KEY =
